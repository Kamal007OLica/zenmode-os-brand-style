{
  "$description": "ZenMode OS design tokens — W3C DTCG format. Import with the Tokens Studio (Figma Tokens) plugin: Plugins → Tokens Studio → Tools → Load from file/folder.",
  "$themes": [],
  "color": {
    "ink": { "$type": "color", "$value": "#12160F", "$description": "Primary text. 13.0:1 on paper. AAA." },
    "ink-soft": { "$type": "color", "$value": "#4A4F46", "$description": "Body secondary. 7.4:1 on paper. AAA." },
    "stone-600": { "$type": "color", "$value": "#5C6158", "$description": "Tertiary text / captions. 4.9:1 on paper. AA." },
    "stone-500": { "$type": "color", "$value": "#6E736A", "$description": "UI text 19sp+ and icons only. 4.3:1 — AA Large." },
    "hairline": { "$type": "color", "$value": "#DCDAD1", "$description": "1dp dividers. Non-text." },
    "paper": { "$type": "color", "$value": "#F2F1EC", "$description": "Light surface base." },
    "paper-raised": { "$type": "color", "$value": "#FBFAF6", "$description": "Raised card top stop." },
    "paper-sunk": { "$type": "color", "$value": "#EDEBE3", "$description": "Raised card bottom stop." },
    "zen-900": { "$type": "color", "$value": "#0B5C12", "$description": "Green pressed state. 7.3:1 on paper. AAA." },
    "zen-700": { "$type": "color", "$value": "#0F7A18", "$description": "BRAND GREEN. Primary. 4.9:1 on paper, 5.5:1 on white. AA." },
    "zen-500": { "$type": "color", "$value": "#2AA136", "$description": "Fills, charts, non-text graphics only. 3.1:1." },
    "zen-300": { "$type": "color", "$value": "#5BDF62", "$description": "On-dark accent + icon glyph on ink. 8.5:1 on ink. AAA." },
    "zen-050": { "$type": "color", "$value": "#E6F6E7", "$description": "Green tint surface." },
    "ember-700": { "$type": "color", "$value": "#B34700", "$description": "Orange text/icon safe. 4.9:1 on paper. AA." },
    "ember-500": { "$type": "color", "$value": "#FF6600", "$description": "YC orange. Gradient + fills. 2.9:1 — never text on paper." },
    "amber-800": { "$type": "color", "$value": "#7A5A00", "$description": "Yellow text safe. 5.7:1 on paper. AA." },
    "amber-500": { "$type": "color", "$value": "#FFC800", "$description": "Vibrant yellow. 9.5:1 on ink. Rewards + gradient." }
  },
  "gradient": {
    "os": {
      "$type": "string",
      "$value": "linear-gradient(100deg, #FF6600 0%, #FFC800 48%, #0F7A18 100%)",
      "$description": "The OS gradient. Orange → yellow → brand green. Wordmark, streak rings, reward states."
    }
  },
  "font": {
    "brand": { "$type": "fontFamily", "$value": "Clash Display", "$description": "Brand layer. Headlines, hero numbers of copy." },
    "system": { "$type": "fontFamily", "$value": "Geist", "$description": "System layer. Every UI string." },
    "number": { "$type": "fontFamily", "$value": "Departure Mono", "$description": "Number layer. Scores, timers, deltas, labels." }
  },
  "type": {
    "display": { "$type": "typography", "$value": { "fontFamily": "Clash Display", "fontWeight": "500", "fontSize": "57sp", "lineHeight": "64sp", "letterSpacing": "-0.02em" } },
    "headline-lg": { "$type": "typography", "$value": { "fontFamily": "Clash Display", "fontWeight": "500", "fontSize": "32sp", "lineHeight": "40sp", "letterSpacing": "-0.015em" } },
    "headline-sm": { "$type": "typography", "$value": { "fontFamily": "Clash Display", "fontWeight": "500", "fontSize": "24sp", "lineHeight": "32sp", "letterSpacing": "-0.01em" } },
    "title": { "$type": "typography", "$value": { "fontFamily": "Geist", "fontWeight": "600", "fontSize": "20sp", "lineHeight": "28sp", "letterSpacing": "0em" } },
    "body-lg": { "$type": "typography", "$value": { "fontFamily": "Geist", "fontWeight": "400", "fontSize": "16sp", "lineHeight": "24sp", "letterSpacing": "0.005em" } },
    "body-md": { "$type": "typography", "$value": { "fontFamily": "Geist", "fontWeight": "400", "fontSize": "14sp", "lineHeight": "20sp", "letterSpacing": "0.01em" } },
    "label": { "$type": "typography", "$value": { "fontFamily": "Geist", "fontWeight": "500", "fontSize": "12sp", "lineHeight": "16sp", "letterSpacing": "0.05em", "textCase": "uppercase" } },
    "metric-xl": { "$type": "typography", "$value": { "fontFamily": "Departure Mono", "fontWeight": "400", "fontSize": "48sp", "lineHeight": "52sp", "letterSpacing": "-0.01em" } },
    "metric": { "$type": "typography", "$value": { "fontFamily": "Departure Mono", "fontWeight": "400", "fontSize": "20sp", "lineHeight": "24sp", "letterSpacing": "0.02em" } },
    "mono-label": { "$type": "typography", "$value": { "fontFamily": "Departure Mono", "fontWeight": "400", "fontSize": "11sp", "lineHeight": "16sp", "letterSpacing": "0.1em", "textCase": "uppercase" } }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4dp" },
    "2": { "$type": "dimension", "$value": "8dp" },
    "3": { "$type": "dimension", "$value": "12dp" },
    "4": { "$type": "dimension", "$value": "16dp" },
    "5": { "$type": "dimension", "$value": "20dp", "$description": "Screen side margin." },
    "6": { "$type": "dimension", "$value": "24dp" },
    "8": { "$type": "dimension", "$value": "32dp" },
    "12": { "$type": "dimension", "$value": "48dp", "$description": "Minimum touch target." }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "8dp", "$description": "Logo construction unit. Icons, chips." },
    "md": { "$type": "dimension", "$value": "16dp" },
    "lg": { "$type": "dimension", "$value": "20dp", "$description": "Cards." },
    "full": { "$type": "dimension", "$value": "999dp" }
  }
}
